{
  "schema_version": 1,
  "contract": {
    "keys": [
      "capacity",
      "confirmed",
      "waiting"
    ],
    "capacity": "positive integer; bool is not accepted",
    "participant_id": "exact nonempty string; case and whitespace preserved",
    "invariants": [
      "IDs unique across both lists",
      "confirmed <= capacity",
      "waiting nonempty implies confirmed is full"
    ],
    "copy_policy": "input unchanged; output dict and both lists are independent, even on a value no-op",
    "execution": "single-process sequential; no concurrent-update guarantees"
  },
  "cases": [
    {
      "id": "free-seat-boundary",
      "initial": {
        "capacity": 2,
        "confirmed": [],
        "waiting": []
      },
      "steps": [
        {
          "operation": "register",
          "participant_id": "Ada",
          "expected": {
            "capacity": 2,
            "confirmed": [
              "Ada"
            ],
            "waiting": []
          }
        },
        {
          "operation": "register",
          "participant_id": "Bo",
          "expected": {
            "capacity": 2,
            "confirmed": [
              "Ada",
              "Bo"
            ],
            "waiting": []
          }
        },
        {
          "operation": "register",
          "participant_id": "Cy",
          "expected": {
            "capacity": 2,
            "confirmed": [
              "Ada",
              "Bo"
            ],
            "waiting": [
              "Cy"
            ]
          }
        }
      ]
    },
